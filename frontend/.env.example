# Database connection string (MySQL / MariaDB / Cloud Database)
DATABASE_URL="mysql://username:password@localhost:3306/mirissastays_db"

# JWT Secret for Session & RBAC Authentication
JWT_SECRET="replace-with-a-random-32-character-secret"

# Public Site URL (e.g., https://mirissastays.com)
NEXT_PUBLIC_SITE_URL="https://mirissastays.com"

# Admin & Notification Email
ADMIN_EMAIL="admin@mirissastays.com"

# SMTP Mail Configuration for Inquiry Alerts & Password Resets
SMTP_HOST="smtp.yourprovider.com"
SMTP_PORT="587"
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"
SMTP_FROM="Mirissa Stays <hello@mirissastays.com>"

# Storage Provider (local | s3 | cloudflare_r2)
STORAGE_PROVIDER="local"
UPLOAD_DIR="./public/uploads"
